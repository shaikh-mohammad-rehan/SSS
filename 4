    if(a == 0 && b == 0)
    {
        printf("Invalid Coefficients!\n");
    }
    else if (a == 0)
    {
        printf("This is not a quadratic equation but Linear Equation.\n");
        root1 =- c / b;
        printf("Linear Equation with root: %.2f\n", root1);
   }
   else
   {
       d =b*b-4*a*c;
       if (d == 0)
       {
            printf("Roots are real and equal.\n");
            root1 =root2 =-b / (2 * a);
            printf("Root = %.2f\n", root1);
       }
       else if (d > 0)
       {
           printf("Roots are real and distinct.\n");
           root1 = (-b + sqrt(d)) / (2 * a);
           root2 = (-b- sqrt(d)) / (2 * a);
           printf("Root 1 = %.2f\n", root1);
           printf("Root 2 = %.2f\n", root2);
      }
      else
      }
          printf("Roots are complex and imaginary.\n");
          root1 =-b / (2 * a);
          root2 = sqrt(abs(d)) / (2 * a);
          printf("Root 1 = %.2f +i %.2f\n", root1, root2);
          printf("Root 2 = %.2lf-i %.2f\n", root1, root2);
      }
  }
  getch():
